# Rename this file to .env and fill in your key

# --- AI backend A (PREFERRED, unlimited & free): local Ollama ---
# The bot uses this first. If unreachable, it falls back to Gemini.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434

# Max time to wait for a local Ollama answer (milliseconds)
OLLAMA_TIMEOUT_MS=39000

# --- AI backend B (fallback): Google Gemini ---
# Google Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# A fast Gemini model. Change only to a model available in your Google project.
GEMINI_MODEL=gemini-3.6-flash

# Optional: path to your database file, defaults to ./database.json
DATABASE_PATH=./database.json

# Optional: your business name, used in the bot's system prompt
BUSINESS_NAME=Tourism Bot

# Optional: max number of past messages to remember per customer (for follow-up questions)
HISTORY_LIMIT=6

# Maximum time to wait for an AI response before returning an error (milliseconds)
AI_TIMEOUT_MS=25000
